# Copy this file to ".env" and fill in your own values. Never commit ".env".

# --- Required ---------------------------------------------------------------
# MongoDB connection string, e.g. a local server or a MongoDB Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017/shopkart
# A long random string (16+ characters) used to sign login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# --- Optional ---------------------------------------------------------------
# Leave unset while developing. Set NODE_ENV=production only when deploying: it makes
# the login cookie Secure, requires real Razorpay keys, and forbids mock payments.
# NODE_ENV=production
# Port for the API. The frontend expects 8000 by default.
PORT=8000
# Address(es) the frontend runs on (comma separated). Used for CORS.
CLIENT_ORIGIN=http://localhost:5173
# Login cookie SameSite: "lax" (default) works when the frontend and API share a
# site, e.g. both on localhost. Use "none" only if they are on different domains
# (HTTPS required).
COOKIE_SAMESITE=lax
# Email addresses (comma separated) allowed to add products and move orders
# through shipping stages. Leave empty to have no administrators.
ADMIN_EMAILS=

# --- Payments (Razorpay, use TEST mode keys while developing) ---------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed if you configure the payment webhook in the Razorpay dashboard
# (endpoint: POST /webhooks/razorpay). Set the same secret there.
RAZORPAY_WEBHOOK_SECRET=

# DEVELOPMENT ONLY: lets you test checkout without Razorpay keys. No real
# payment happens and orders are labelled as test payments. It is ignored when
# Razorpay keys are set and the server refuses to start with it in production.
ALLOW_MOCK_PAYMENTS=false
